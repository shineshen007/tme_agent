{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Research EvidenceRecord v3 (explicit bindings)",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "source", "biological_entity", "observation", "provenance"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "evidence_id": {"type": "string", "pattern": "^ev_[0-9a-f]{20}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["omics", "cohort", "evidence_layer", "evidence_context", "measured_omics", "analysis_unit"],
      "properties": {
        "omics": {"type": "string", "minLength": 1},
        "cohort": {"type": "string", "minLength": 1},
        "assay": {"type": "string"}, "analysis": {"type": "string"},
        "evidence_layer": {"enum": ["de", "pathway_enrichment", "prognosis", "tcell_correlation", "scrna_context"]},
        "evidence_context": {"enum": ["measured_evidence", "derived_estimate", "external_context"]},
        "measured_omics": {"type": "array", "uniqueItems": true, "items": {"enum": ["transcriptomics", "proteomics", "metabolomics", "epigenomics", "genomics", "scrna", "spatial"]}},
        "analysis_unit": {"type": "string", "minLength": 1}
      },
      "allOf": [{"if": {"properties": {"evidence_context": {"enum": ["derived_estimate", "external_context"]}}}, "then": {"properties": {"measured_omics": {"maxItems": 0}}}}]
    },
    "biological_entity": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_type", "entity_id", "namespace", "species", "symbol", "tissue_context"],
      "properties": {
        "entity_type": {"type": "string", "minLength": 1},
        "entity_id": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "species": {"type": "string", "minLength": 1},
        "symbol": {"type": "string"}, "tissue_context": {"type": "string"},
        "pathway": {"type": "string"}, "cell_type": {"type": "string"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["effect", "p_value", "adjusted_p", "n", "selected", "selection", "status", "effect_scale", "claim_type", "direction", "missing_fields"],
      "properties": {
        "effect": {"type": ["number", "null"]},
        "p_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "adjusted_p": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "n": {"type": ["integer", "null"], "minimum": 0},
        "selected": {"type": ["boolean", "null"]},
        "selection": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "verified", "raw_selected", "selected", "adjusted_p_max",
                       "effect_min", "effect_max", "analysis_unit_count", "reasons"],
          "properties": {
            "status": {"enum": ["verified_selected", "verified_not_selected", "not_verifiable", "not_applicable"]},
            "verified": {"type": "boolean"},
            "raw_selected": {"type": ["boolean", "null"]},
            "selected": {"type": ["boolean", "null"]},
            "adjusted_p_max": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "effect_min": {"type": ["number", "null"]},
            "effect_max": {"type": ["number", "null"]},
            "analysis_unit_count": {"type": ["integer", "null"], "minimum": 3},
            "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "status": {"type": "string"}, "effect_scale": {"type": "string"},
        "claim_type": {"const": "statistical_fact"},
        "direction": {"type": "string"},
        "missing_fields": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_path", "sha256", "row_key", "row_index", "columns", "plan_hash"],
      "properties": {
        "artifact_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "row_key": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "row_index": {"type": ["integer", "null"], "minimum": 1},
        "columns": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "plan_hash": {"type": "string", "minLength": 1},
        "legacy_evidence_id": {"type": "string", "pattern": "^ev_[0-9a-f]{20}$"}
      }
    }
  }
}
