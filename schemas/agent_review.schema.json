{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "decision",
    "issues",
    "overall_assessment",
    "unresolved_issues"
  ],
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "category",
          "target_hypothesis_id",
          "description",
          "required_fix",
          "issue_id",
          "resolvable_by"
        ],
        "properties": {
          "severity": {
            "enum": [
              "blocking",
              "major",
              "minor"
            ]
          },
          "category": {
            "enum": [
              "evidence_rule",
              "counterevidence",
              "causal_language",
              "extrapolation",
              "citation",
              "targets",
              "double_counting",
              "alternative_explanation"
            ]
          },
          "target_hypothesis_id": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required_fix": {
            "type": "string",
            "minLength": 1
          },
          "issue_id": {
            "type": "string",
            "pattern": "^C[1-9][0-9]*$"
          },
          "resolvable_by": {
            "enum": [
              "reasoning_revision",
              "reanalysis",
              "human_review"
            ]
          },
          "scientific_question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "resolvable_by": {
                  "const": "reanalysis"
                }
              }
            },
            "then": {
              "required": [
                "scientific_question"
              ]
            }
          }
        ]
      }
    },
    "overall_assessment": {
      "type": "string",
      "minLength": 1
    },
    "unresolved_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "enum": [
        "accept",
        "revise_reasoning",
        "request_analysis",
        "block"
      ]
    }
  },
  "additionalProperties": false
}
