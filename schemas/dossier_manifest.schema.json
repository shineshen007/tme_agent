{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Target dossier manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "source_run", "resolution", "boundaries",
                "inputs", "code", "outputs", "content_hash", "generated_at", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "slug", "kind", "group", "group_type", "evidence_ids_cited"],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "minLength": 1},
        "kind": {"type": "string"},
        "group": {"type": "string"},
        "group_type": {"type": "string"},
        "evidence_ids_cited": {"type": "array", "items": {"type": "string", "pattern": "^ev_[0-9a-f]{20}$"}}
      }
    },
    "source_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "fingerprint", "artifact_manifest_sha256"],
      "properties": {
        "run_id": {"type": "string"},
        "fingerprint": {"type": "string"},
        "artifact_manifest_sha256": {"type": "string"}
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unresolved_reasons"],
      "properties": {
        "transcriptomics": {"type": "array", "items": {"type": "string"}},
        "proteomics": {"type": "array", "items": {"type": "string"}},
        "metabolomics": {"type": "array", "items": {"type": "string"}},
        "unresolved_reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_status", "evidence_layers", "prognosis", "tcell", "km", "cohort_nesting"],
      "properties": {
        "validation_status": {"const": "not_independently_validated"},
        "evidence_layers": {"type": "array", "items": {"type": "string"}},
        "prognosis": {"type": "string"},
        "tcell": {"type": "string"},
        "km": {"const": "display_only_no_test"},
        "cohort_nesting": {"type": "string"}
      }
    },
    "render_config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "panels": {"type": "array", "items": {"type": "string"}},
        "formats": {"type": "array", "items": {"type": "string"}},
        "max_panels_per_page": {"type": "integer", "minimum": 1},
        "km_mode": {"type": "string"},
        "km_outcomes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "sha256"],
      "properties": {
        "module": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_at": {"type": "string"},
    "status": {"enum": ["complete", "partial", "failed"]},
    "skipped_panels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["panel", "reason"],
        "properties": {"panel": {"type": "string"}, "reason": {"type": "string"}}
      }
    }
  }
}
