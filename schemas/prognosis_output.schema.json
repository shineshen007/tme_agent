{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "omics",
    "cohort_id",
    "scope",
    "evidence_boundary",
    "axis",
    "n_patients",
    "n_events_os",
    "n_events_rfs",
    "n_cox_rows",
    "analyses",
    "artifacts",
    "qc",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "complete",
        "review_only",
        "failed",
        "blocked",
        "skipped"
      ]
    },
    "omics": {
      "const": "prognosis_candidate_axis"
    },
    "cohort_id": {
      "type": "array",
      "items": {
        "enum": [
          "triple109",
          "same_batch108"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "evidence_boundary": {
      "const": "candidate_axis_tracking_prespecified_not_discovery"
    },
    "axis": {
      "type": "string",
      "minLength": 1
    },
    "n_patients": {
      "type": "integer",
      "minimum": 0
    },
    "n_events_os": {
      "type": "integer",
      "minimum": 0
    },
    "n_events_rfs": {
      "type": "integer",
      "minimum": 0
    },
    "n_cox_rows": {
      "type": "integer",
      "minimum": 0
    },
    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "complete",
              "blocked",
              "failed",
              "skipped"
            ]
          },
          "n_rows": {
            "type": "integer",
            "minimum": 0
          },
          "method": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "qc": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "message",
          "resolved"
        ],
        "properties": {
          "step": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "resolved": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
