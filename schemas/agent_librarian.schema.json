{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["queries"],
  "properties": {
    "queries": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["query", "axis", "rationale"],
        "properties": {
          "query": {"type": "string", "minLength": 3},
          "axis": {"type": "string"},
          "rationale": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
